JWT_EXPIRES_IN=7d
ADMIN_SIGNUP_CODE=replace_with_a_private_invite_code

# ---- AI Chatbot ----
OPENAI_API_KEY=sk-replace-with-your-real-key
OPENAI_MODEL=gpt-4o-mini
